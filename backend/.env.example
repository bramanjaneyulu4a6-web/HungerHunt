PORT=5000
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/hungerhunt
JWT_SECRET=change-me-to-a-long-random-string
MAX_ADMIN_ACCOUNTS=5

# Signs parent tokens. It falls back to JWT_SECRET if unset, and the role claim
# on every token separates admins from parents either way — but set it. With a
# second key a token for one side fails the signature on the other, before any
# claim is read, instead of resting on the role check being applied by whatever
# middleware is written next. Must be different from JWT_SECRET.
PARENT_JWT_SECRET=change-me-to-a-different-long-random-string

# Tokens issued before tokens carried a role claim are accepted until this date,
# so deploying the change does not sign everyone out. It has to be one parent
# token lifetime (7 days) past the *deploy*, not past the change — until this
# reaches production, production is still issuing roleless tokens and the clock
# has not started. Move it whenever the deploy moves. Once it passes, every
# pre-existing token has expired and the setting does nothing.
#
# Set PARENT_JWT_SECRET before this date, not after: while the window is open a
# parent token signed with the old key is still accepted, which is what carries
# parents across the changeover without signing them out.
# LEGACY_TOKEN_GRACE_UNTIL=2026-08-20T00:00:00Z

# A bill must carry the single-use token that verify-payment returns once the
# parent's purchase password is accepted. Bills sent without one are still
# charged until this date, so a till running a bundle it loaded before this
# change keeps selling, and each one is logged. Bring the date forward once
# those log lines stop to close the gap early. Bills that do carry a token are
# checked in full from the first day, whatever this is set to.
# PURCHASE_AUTH_GRACE_UNTIL=2026-08-21T00:00:00Z

# Number of proxies between the internet and this server, so rate limiting sees
# the real client IP instead of the proxy's. Most managed hosts put exactly one
# in front; leave it unset when the server is reached directly, as it is locally.
# Never set it to "true" — that lets any client spoof its IP past the limiter.
# TRUST_PROXY=1

# Base URLs used to build links in outgoing emails (password reset, etc.)
PARENT_CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174

# SMTP (Gmail app password)
EMAIL_USER=you@example.com
EMAIL_PASS=your-app-password

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin — push notifications. Omit to disable them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Dev-only login bypass. With this set to "true" every admin and parent route
# is served as the first admin/parent in the database, with no token required.
# Honoured only when NODE_ENV=development, so anything else — unset, "staging",
# a typo — ignores it. Setting it with NODE_ENV=production fails the boot.
# AUTH_BYPASS=false
