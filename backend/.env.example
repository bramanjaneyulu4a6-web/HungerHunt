# 5001 rather than 5000, which macOS gives to the AirPlay Receiver. That
# listener answers 403 rather than refusing the connection, so a frontend
# pointed at 5000 on a Mac does not fail like a missing server — it fails like
# a broken login, and sends whoever is debugging it into the auth middleware
# looking for a bug that is not there.
PORT=5001
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/hungerhunt
JWT_SECRET=change-me-to-a-long-random-string
# IANA timezone used for DAILY/WEEKLY/MONTHLY spending-limit boundaries.
BUSINESS_TIME_ZONE=Asia/Kolkata
MAX_ADMIN_ACCOUNTS=5

# Storeroom accounts. A warehouse account can see and raise purchase orders,
# receive deliveries, and read stock and suppliers — no students, no wallets,
# no prices, no till.
MAX_WAREHOUSE_ACCOUNTS=5

# Dorm delivery accounts. Every caretaker is assigned to exactly one hostel
# and can only confirm that hostel's out-for-delivery packages.
MAX_CARETAKER_ACCOUNTS=20

# Signs parent tokens. It falls back to JWT_SECRET if unset, and the role claim
# on every token separates admins from parents either way — but set it. With a
# second key a token for one side fails the signature on the other, before any
# claim is read, instead of resting on the role check being applied by whatever
# middleware is written next. Must be different from JWT_SECRET.
PARENT_JWT_SECRET=change-me-to-a-different-long-random-string

# Signs the kiosk's student sessions, which last 7 minutes 30 seconds and are
# issued from an admission number alone. Optional and falls back to JWT_SECRET,
# so an unset key does not turn every terminal away on deploy — but set it: the
# fallback means a kiosk session is signed with the key that also signs staff.
STUDENT_JWT_SECRET=change-me-to-a-third-long-random-string

# Tokens issued before tokens carried a role claim are accepted until this date,
# so deploying the change does not sign everyone out. It has to be one parent
# token lifetime (7 days) past the *deploy*, not past the change — until this
# reaches production, production is still issuing roleless tokens and the clock
# has not started. Move it whenever the deploy moves. Once it passes, every
# pre-existing token has expired and the setting does nothing.
#
# Set PARENT_JWT_SECRET before this date, not after: while the window is open a
# parent token signed with the old key is still accepted, which is what carries
# parents across the changeover without signing them out.
# LEGACY_TOKEN_GRACE_UNTIL=2026-08-20T00:00:00Z

# A bill must carry the single-use token that verify-payment returns once the
# parent's purchase password is accepted. Bills sent without one are still
# charged until this date, so a till running a bundle it loaded before this
# change keeps selling, and each one is logged. Bring the date forward once
# those log lines stop to close the gap early. Bills that do carry a token are
# checked in full from the first day, whatever this is set to.
# PURCHASE_AUTH_GRACE_UNTIL=2026-08-21T00:00:00Z

# Number of proxies between the internet and this server, so rate limiting sees
# the real client IP instead of the proxy's. Most managed hosts put exactly one
# in front; leave it unset when the server is reached directly, as it is locally.
# Never set it to "true" — that lets any client spoof its IP past the limiter.
# TRUST_PROXY=1

# Base URLs used to build links in outgoing emails (password reset, etc.)
PARENT_CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
WAREHOUSE_CLIENT_URL=http://localhost:5176
KIOSK_CLIENT_URL=http://localhost:5175
# Additional comma-separated origins for previews or multiple deployed hosts.
# CORS_ORIGINS=https://admin.example.com,https://warehouse.example.com

# SMTP (Gmail app password)
EMAIL_USER=you@example.com
EMAIL_PASS=your-app-password

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin — push notifications. Omit to disable them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The Warehouse–Accounts v1 slice: /api/v1/purchase-orders, /api/v1/analytics,
# the x-request-id middleware and the { message, error, meta } error envelope.
# Enabled by default. Set the exact string "false" only as an emergency kill
# switch; while false, orders already awaiting review are temporarily hidden.
# Orders already in the PENDING_REVIEW workflow are not rolled back by turning
# it off — they simply become unreachable until it is on again.
# FEATURE_V1_PROCUREMENT=true

# TallyPrime voucher import. These ledger/voucher names must already exist in
# the target Tally company and match exactly. Defaults are shown here.
TALLY_WALLET_LEDGER=Student Wallet Liability
TALLY_SALES_LEDGER=HungerHunt Sales
TALLY_FUNDING_LEDGER=Wallet Funding Clearing
TALLY_SALES_VOUCHER_TYPE=Sales
TALLY_RECEIPT_VOUCHER_TYPE=Receipt
TALLY_REFUND_VOUCHER_TYPE=Credit Note

# Deterministic analytics policy (all optional; documented defaults shown).
# Read only when FEATURE_V1_PROCUREMENT is on.
ANALYTICS_HIGH_VELOCITY_PER_DAY=1
ANALYTICS_DEFAULT_LEAD_TIME_DAYS=7
ANALYTICS_ORDERING_COST=250
ANALYTICS_ANNUAL_HOLDING_RATE=0.2
