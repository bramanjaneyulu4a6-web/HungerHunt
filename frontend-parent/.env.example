VITE_API_BASE_URL=http://localhost:5000/api

# --- Push notifications -------------------------------------------------
# Web push only. The iOS and Android builds read their credentials from
# GoogleService-Info.plist / google-services.json instead — see README.
#
# These are Firebase's public client values (they ship in the JS bundle by
# design); they live here so a staging project can be pointed at without
# editing source. Copy them from Firebase Console → Project settings → General
# → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
VITE_VAPID_KEY=your-firebase-web-push-vapid-key

# Dev-only login bypass. Set to "true" to skip the login screen while
# developing. Requires AUTH_BYPASS=true on the backend, and has no effect in a
# production build.
# VITE_AUTH_BYPASS=false
