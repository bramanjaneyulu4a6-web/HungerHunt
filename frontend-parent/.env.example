VITE_API_BASE_URL=http://localhost:5001/api
VITE_PHONEPE_NATIVE_SDK_ENABLED=false

# --- Firebase: SMS verification and push notifications ------------------
# These values power browser SMS verification and web push. The iOS and
# Android builds read credentials from GoogleService-Info.plist /
# google-services.json instead — see README.
#
# These are Firebase's public client values (they ship in the JS bundle by
# design); they live here so a staging project can be pointed at without
# editing source. Copy them from Firebase Console → Project settings → General
# → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
VITE_VAPID_KEY=your-firebase-web-push-vapid-key

# --- UPI payments -------------------------------------------------------
# Shows the "Pay by UPI" and "Add money by UPI" buttons. Anything other than
# the exact string "true" hides them, so a build that omits this ships the
# app without the feature rather than with a broken one.
#
# Only turn this on once the backend has its PHONEPE_* credentials (see
# backend/.env.example). Without them every tap reaches PhonePe, fails the
# token request, and tells the parent the payment service is not answering.
VITE_PAYMENTS_ENABLED=false

# Keeps the frontend-only UPI preview visible while live payments are off.
# It is clearly labelled as a demo and never calls the payment API or changes
# a wallet. Set false when the preview should be removed from a release.
VITE_DEMO_UPI_ENABLED=true
