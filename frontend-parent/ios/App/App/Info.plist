	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>firebase-phone-auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-383327390863-ios-9dc6a25b80dbe86dfb34fa</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>phonepe-payment-return</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hungerhuntpay</string>
			</array>
		</dict>
	</array>
