# The live backend. This app talks to production by default — there is no
# localhost fallback in src/utils/api.js, so an unset value makes every request
# resolve against the app's own origin and fail at login with nothing useful in
# the console.
#
# The value is read at build time, not at runtime: `npm run build` bakes it into
# the bundle, so a build made against the wrong value cannot be corrected by
# changing this file afterwards. That matters most for the Android APK, which
# carries whatever this said when it was wrapped.
VITE_API_BASE_URL=https://hungerhunt-dbat.onrender.com/api

# Switches the kiosk's login off. With this set to exactly `true`, the terminal
# never asks for an admission number: it opens straight onto the selection
# screen driving the demo student (DEMO01, from backend/scripts/createDemoStudent.js),
# and nothing any visitor does is recorded — no wallet debit, no stock movement,
# no transaction, no package, no notification. Anything other than `true`,
# including leaving it out, leaves the gate standing.
#
# Baked in at build time like the URL above, so turning the gate back on is a
# redeploy and a fresh APK, not an edit to this file on a running tablet.
#
# And note where "this file" is not. The real .env is gitignored, so it governs
# `npm run dev` and any APK wrapped on this machine — and nothing else. The
# Vercel build clones a repo that has no .env at all and reads its variables
# from the project's own environment settings, the same as VITE_API_BASE_URL.
# Set this in one place and not the other and half the kiosks keep their gate,
# which looks from the outside like the flag not working.
#
# The demo account must be seeded on whichever backend the URL above points at,
# or the kiosk opens on "Sorry, please try again later":
#   npm run student:demo -- --room H1 --prod --apply
# VITE_KIOSK_LOGIN_DISABLED=true

# The account the line above drives. Defaults to DEMO01; only worth setting if a
# second demo row has been seeded under another admission number. The kiosk
# refuses whatever comes back unless the server marks it demoAccount, so this
# cannot be pointed at a real child.
# VITE_KIOSK_DEMO_ADMISSION=DEMO01
