# Release signing — copy to keystore.properties and fill in.
#
#   cp keystore.properties.example keystore.properties
#
# keystore.properties is gitignored, and so are *.jks and *.keystore. The real
# file and the keystore it points at must both stay out of the repo: git keeps
# what it has been given even after the file is removed.
#
# This app is sideloaded, not published, so nothing here is registered with
# Google — which means nothing can reset the key either. Android refuses an
# update signed by a different key than the installed copy, and the only way
# out is to uninstall and reinstall on every terminal, which clears the stored
# session with it. Back the keystore up somewhere other than the machine that
# made it.
#
# The kiosk and the warehouse app can share one keystore and one alias; they
# are both internal builds for school-owned devices. Keep them separate from
# the parent app's Play upload key, which lives under different rules — Play
# App Signing can reset that one, and it should not be spread across more
# machines than the release that needs it.
#
# Every value here can come from an environment variable instead, which is how
# a build machine supplies them — the name is listed beside each one. The file
# wins where both are set, and the two can be mixed: the path here, the
# passwords in the environment.

# Absolute path to the keystore. Outside the repo — a relative path here is
# resolved against android/app/, which is inside it.
#                                                     $ANDROID_KEYSTORE_PATH
storeFile=/Users/you/keys/hungerhunt-internal.jks

# The password protecting the keystore file itself.  $ANDROID_KEYSTORE_PASSWORD
storePassword=

# The name given to the key at -alias when it was created.  $ANDROID_KEY_ALIAS
keyAlias=internal

# The password protecting that key. keytool offers to reuse the store password;
# if it was reused, this is the same value.             $ANDROID_KEY_PASSWORD
keyPassword=
